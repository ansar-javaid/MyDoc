@page "{id:int}"
@model MyDoc.Pages.Documents.EditModel
@{ViewData["Title"]=Model.Document?.Title??"Document";}@if(TempData["Success"] is string s){<div class="alert alert-success">@s</div>}@if(TempData["Error"] is string e){<div class="alert alert-danger">@e</div>}<div class="editor-top"><a asp-page="/Index" class="back-link">← All documents</a><div class="access-info">Owner: <strong>@Model.Document!.Owner.FullName</strong> · <span class="badge badge-shared">@Model.Access</span></div></div><div class="editor-layout"><section class="editor-card"><div class="editor-header"><input id="title" class="title-input" value="@Model.Document!.Title" maxlength="200" aria-label="Document title" readonly="@(!Model.CanEdit)"/><div class="save-controls">@if(Model.CanEdit){<button id="saveButton" type="button" class="btn btn-primary btn-sm">Save</button>}<span id="saveStatus">@(Model.CanEdit?"Saved":"Read-only")</span></div></div><div id="toolbar" class="ql-toolbar ql-snow"><span class="ql-formats"><select class="ql-header"><option selected></option><option value="1"></option><option value="2"></option><option value="3"></option></select><select class="ql-size"></select></span><span class="ql-formats"><button class="ql-bold"></button><button class="ql-italic"></button><button class="ql-underline"></button><button class="ql-strike"></button></span><span class="ql-formats"><select class="ql-color"></select><select class="ql-background"></select></span><span class="ql-formats"><button class="ql-list" value="ordered"></button><button class="ql-list" value="bullet"></button><button class="ql-blockquote"></button><button class="ql-code-block"></button></span><span class="ql-formats"><select class="ql-align"></select><button class="ql-indent" value="-1"></button><button class="ql-indent" value="+1"></button><button class="ql-link"></button><button class="ql-clean"></button></span></div><div id="editor">@Html.Raw(Model.Document.ContentHtml)</div><div class="editor-footer"><span id="counts"></span>@if(!Model.CanEdit){<span class="read-only-note">Viewer access — editing is disabled.</span>}</div></section><aside class="sharing-panel"><h2>Share</h2>@if(Model.IsOwner){<form method="post" asp-page-handler="Share" class="vstack gap-2"><label class="form-label">Registered user email</label><input class="form-control" type="email" name="email" required placeholder="person@example.com"/><select class="form-select" name="permission"><option value="Viewer">Viewer</option><option value="Editor">Editor</option></select><button class="btn btn-outline-primary">Share document</button></form><hr/>@foreach(var share in Model.Document.Shares){<div class="collaborator"><span>@share.User.FullName<small>@share.User.Email · @share.Permission</small></span><form method="post" asp-page-handler="Revoke"><input type="hidden" name="userId" value="@share.UserId"/><button class="btn btn-link btn-sm text-danger">Revoke</button></form></div>}}else{<p class="small text-secondary">Only the owner can manage sharing.</p>}<hr/><h3 class="h6">Version history</h3><button id="versionsButton" type="button" class="btn btn-sm btn-outline-secondary">Load versions</button><div id="versions" class="mt-2 small"></div></aside></div>
@section Scripts{<link href="https://cdn.jsdelivr.net/npm/quill@2.0.3/dist/quill.snow.css" rel="stylesheet"><script src="https://cdn.jsdelivr.net/npm/quill@2.0.3/dist/quill.js"></script><form id="token" style="display:none">@Html.AntiForgeryToken()</form><script>const editable=@Model.CanEdit.ToString().ToLowerInvariant(),q=new Quill('#editor',{theme:'snow',modules:{toolbar:'#toolbar',history:{delay:700,maxStack:100,userOnly:true}},readOnly:!editable}),title=document.querySelector('#title'),status=document.querySelector('#saveStatus'),counts=document.querySelector('#counts');let dirty=false,timer,saving=false;function count(){let t=q.getText().trim();counts.textContent=`${t? t.split(/\s+/).length:0} words · ${t.length} characters`;}count();async function save(){if(!editable||saving||!dirty)return;saving=true;status.textContent='Saving…';try{let f=new FormData();f.append('title',title.value);f.append('contentHtml',q.root.innerHTML);f.append('__RequestVerificationToken',document.querySelector('#token input').value);let r=await fetch('?handler=Save',{method:'POST',body:f});if(!r.ok)throw 0;let x=await r.json();status.textContent='Saved '+new Date(x.savedAt).toLocaleTimeString();dirty=false;}catch{status.textContent='Save failed — changes remain in this browser.';}finally{saving=false;}}function change(){dirty=true;count();status.textContent='Unsaved changes';clearTimeout(timer);timer=setTimeout(save,900);}if(editable){q.on('text-change',change);title.addEventListener('input',change);document.querySelector('#saveButton').onclick=save;window.addEventListener('beforeunload',e=>{if(dirty){e.preventDefault();e.returnValue='';}});q.keyboard.addBinding({key:'z',shortKey:true},()=>q.history.undo());q.keyboard.addBinding({key:'y',shortKey:true},()=>q.history.redo());}document.querySelector('#versionsButton').onclick=async()=>{let r=await fetch('?handler=Versions');let v=await r.json();document.querySelector('#versions').innerHTML=v.length?v.map(x=>`<div class="border-top py-2"><b>v${x.versionNumber}</b> ${new Date(x.createdAtUtc).toLocaleString()}<br>${x.author} @if(Model.CanEdit){<form method="post" action="?handler=Restore" class="d-inline"><input type="hidden" name="versionId" value="${x.id}"><input type="hidden" name="__RequestVerificationToken" value="${document.querySelector('#token input').value}"><button class="btn btn-link btn-sm">Restore</button></form>}</div>`).join(''):'No prior versions yet.';};</script>}
