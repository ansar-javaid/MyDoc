@page "{id:int}"
@model MyDoc.Pages.Documents.EditModel
@{ ViewData["Title"]=Model.Document?.Title??"Document"; }
@if(TempData["Success"] is string success){<div class="alert alert-success">@success</div>}@if(TempData["Error"] is string error){<div class="alert alert-danger">@error</div>}
<div class="editor-top"><a asp-page="/Index" class="back-link">← All documents</a><div class="access-info">Owner: <strong>@Model.Document!.Owner.Name</strong> · Your access: <span class="badge badge-shared">@Model.Access</span></div></div>
<div class="editor-layout"><section class="editor-card"><div class="editor-header"><input id="title" class="title-input" value="@Model.Document!.Title" maxlength="200" aria-label="Document title" @(Model.CanEdit?"":"readonly")/><div class="save-controls">@if(Model.CanEdit){<button id="saveButton" class="btn btn-primary btn-sm">Save</button>}<span id="saveStatus" aria-live="polite">@if(Model.CanEdit){<text>Saved</text>}else{<text>Read-only</text>}</span></div></div><div id="toolbar" class="ql-toolbar ql-snow"><span class="ql-formats"><select class="ql-header"><option selected></option><option value="1"></option><option value="2"></option><option value="3"></option></select></span><span class="ql-formats"><button class="ql-bold"></button><button class="ql-italic"></button><button class="ql-underline"></button></span><span class="ql-formats"><button class="ql-list" value="ordered"></button><button class="ql-list" value="bullet"></button></span></div><div id="editor">@Html.Raw(Model.Document.ContentHtml)</div>@if(!Model.CanEdit){<p class="read-only-note">This document is shared with you as a viewer. Server-side access control prevents editing.</p>}</section>
@if(Model.IsOwner){<aside class="sharing-panel"><h2>Sharing</h2><p class="text-secondary small">Owners can grant or revoke access.</p><form method="post" asp-page-handler="Share" class="vstack gap-2"><label class="form-label">Collaborator</label><select class="form-select" name="userId">@foreach(var u in Model.OtherUsers){<option value="@u.Id">@u.Name (@u.Email)</option>}</select><label class="form-label">Permission</label><select class="form-select" name="permission"><option value="Viewer">Viewer</option><option value="Editor">Editor</option></select><button class="btn btn-outline-primary">Grant access</button></form><hr/><h3 class="h6">Current collaborators</h3>@if(!Model.Document.Shares.Any()){<p class="small text-secondary">No collaborators yet.</p>}else{<ul class="list-unstyled">@foreach(var share in Model.Document.Shares){<li class="collaborator"><span>@share.User.Name <small>@share.Permission</small></span><form method="post" asp-page-handler="Revoke"><input type="hidden" name="userId" value="@share.UserId"/><button class="btn btn-link btn-sm text-danger">Revoke</button></form></li>}</ul>}</aside>}</div>
@section Scripts {<link href="https://cdn.jsdelivr.net/npm/quill@2.0.3/dist/quill.snow.css" rel="stylesheet"><script src="https://cdn.jsdelivr.net/npm/quill@2.0.3/dist/quill.js"></script><script>const editable=@Model.CanEdit.ToString().ToLowerInvariant(), editor=new Quill('#editor',{theme:'snow',modules:{toolbar:'#toolbar'},readOnly:!editable});const status=document.getElementById('saveStatus'),title=document.getElementById('title');let timer,saving=false,dirty=false;async function save(){if(!editable||saving||!dirty)return;saving=true;status.textContent='Saving…';try{const fd=new FormData();fd.append('title',title.value);fd.append('contentHtml',editor.root.innerHTML);fd.append('__RequestVerificationToken',document.querySelector('input[name=__RequestVerificationToken]').value);const r=await fetch('?handler=Save',{method:'POST',body:fd});if(!r.ok)throw new Error();const data=await r.json();status.textContent='Saved '+new Date(data.savedAt).toLocaleTimeString();dirty=false}catch(e){status.textContent='Save failed — your changes remain here. Try Save again.'}finally{saving=false}}function changed(){dirty=true;status.textContent='Unsaved changes';clearTimeout(timer);timer=setTimeout(save,900)}if(editable){editor.on('text-change',changed);title.addEventListener('input',changed);document.getElementById('saveButton').addEventListener('click',save);window.addEventListener('beforeunload',e=>{if(dirty){e.preventDefault();e.returnValue='';}})};</script><form style="display:none">@Html.AntiForgeryToken()</form>}
