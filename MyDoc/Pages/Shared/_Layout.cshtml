<!DOCTYPE html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1.0"/><title>@ViewData["Title"] · DocSpace</title><link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css"/><link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/></head><body><header class="app-nav"><div class="container d-flex align-items-center justify-content-between gap-3"><a class="brand" asp-page="/Index">Doc<span>Space</span></a>@if(User.Identity?.IsAuthenticated==true){<div class="d-flex align-items-center gap-3"><span class="small text-secondary">@User.Identity.Name</span><form method="post" asp-page="/Account/Logout"><button class="btn btn-sm btn-outline-secondary">Logout</button></form></div>}else{<div class="d-flex gap-2"><a class="btn btn-sm btn-outline-primary" asp-page="/Account/Login">Login</a><a class="btn btn-sm btn-primary" asp-page="/Account/Register">Register</a></div>}</div></header><main class="container py-4">@RenderBody()</main><script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>@await RenderSectionAsync("Scripts",required:false)</body></html>
