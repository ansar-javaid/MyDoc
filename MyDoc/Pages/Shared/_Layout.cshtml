@using MyDoc.Data
@inject DocSpaceDbContext Db
@{var navUsers=Db.Users.OrderBy(u=>u.Name).ToList();var active=Context.Session.GetInt32("DocSpace.DemoUserId");}
<!DOCTYPE html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1.0"/><title>@ViewData["Title"] · DocSpace</title><link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css"/><link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/></head><body><header class="app-nav"><div class="container d-flex align-items-center justify-content-between gap-3"><a class="brand" asp-page="/Index">Doc<span>Space</span></a><form method="post" asp-page="/Index" asp-page-handler="SwitchUser" class="d-flex align-items-center gap-2"><label class="small text-secondary" for="demoUser">Demo user</label><select id="demoUser" name="userId" class="form-select form-select-sm" onchange="this.form.submit()"><option value="">Choose user</option>@foreach(var u in navUsers){<option value="@u.Id" selected="@(active==u.Id)">@u.Name</option>}</select></form></div></header><main class="container py-4">@RenderBody()</main><script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>@await RenderSectionAsync("Scripts",required:false)</body></html>
