@page
@model IndexModel
@{ ViewData["Title"]="Your documents"; }
@if(TempData["Success"] is string success){<div class="alert alert-success">@success</div>}@if(TempData["Error"] is string error){<div class="alert alert-danger">@error</div>}
<section class="dashboard-hero d-flex justify-content-between align-items-center flex-wrap gap-3"><div><p class="eyebrow">WORKSPACE</p><h1>Your documents</h1><p class="text-secondary mb-0">Create, write, and share with a focused demo workspace.</p></div><div class="d-flex gap-2"><form method="post" asp-page-handler="Create"><button class="btn btn-primary">+ New document</button></form><button class="btn btn-outline-primary" data-bs-toggle="modal" data-bs-target="#importModal">Import file</button></div></section>
@if(Model.CurrentUser is null){<div class="empty-state"><h2>Choose a demo user to begin</h2><p>Select Alice or Bob in the header. This assignment uses a server-managed demo session.</p></div>}else{<section class="mt-5"><div class="section-title"><h2>Owned by you</h2><span>@Model.Owned.Count document(s)</span></div>@if(!Model.Owned.Any()){<div class="empty-state"><p>No documents yet. Create one or import a text file.</p></div>}else{<div class="row g-3">@foreach(var doc in Model.Owned){<div class="col-md-6 col-lg-4"><article class="doc-card"><div><span class="badge badge-owner">Owner</span><h3>@doc.Title</h3><p>Updated @doc.UpdatedAtUtc.ToLocalTime().ToString("g")</p></div><div class="d-flex gap-2"><a class="btn btn-sm btn-primary" asp-page="/Documents/Edit" asp-route-id="@doc.Id">Open</a><form method="post" asp-page-handler="Delete" onsubmit="return confirm('Delete this document?');"><input type="hidden" name="id" value="@doc.Id"/><button class="btn btn-sm btn-outline-danger">Delete</button></form></div></article></div>}</div>}</section><section class="mt-5"><div class="section-title"><h2>Shared with me</h2><span>@Model.Shared.Count document(s)</span></div>@if(!Model.Shared.Any()){<div class="empty-state"><p>Nothing has been shared with you yet.</p></div>}else{<div class="row g-3">@foreach(var doc in Model.Shared){var permission=doc.Shares.Single(s=>s.UserId==Model.CurrentUser.Id).Permission;<div class="col-md-6 col-lg-4"><article class="doc-card"><div><span class="badge badge-shared">@permission</span><h3>@doc.Title</h3><p>Owner: @doc.Owner.Name · Updated @doc.UpdatedAtUtc.ToLocalTime().ToString("g")</p></div><a class="btn btn-sm btn-primary" asp-page="/Documents/Edit" asp-route-id="@doc.Id">Open</a></article></div>}</div>}</section>}
<div class="modal fade" id="importModal" tabindex="-1"><div class="modal-dialog"><form class="modal-content" method="post" enctype="multipart/form-data" asp-page-handler="Import"><div class="modal-header"><h2 class="h5">Import text or Markdown</h2><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div><div class="modal-body"><label class="form-label">File (.txt or .md, max 1 MB)</label><input class="form-control" asp-for="ImportFile" accept=".txt,.md,text/plain,text/markdown" required/><label class="form-label mt-3">Document title (optional)</label><input class="form-control" asp-for="ImportTitle" maxlength="200"/></div><div class="modal-footer"><button class="btn btn-primary">Import</button></div></form></div></div>
