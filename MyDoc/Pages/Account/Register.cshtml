@model MyDoc.Pages.Account.RegisterModel
@{ViewData["Title"]="Create account";}<div class="auth-card"><h1>Create your workspace</h1><p class="text-secondary">Start writing with DocSpace.</p><form method="post" class="vstack gap-3"><div><label asp-for="Input.FullName" class="form-label">Full name</label><input asp-for="Input.FullName" class="form-control"/><span asp-validation-for="Input.FullName" class="text-danger"></span></div><div><label asp-for="Input.Email" class="form-label">Email</label><input asp-for="Input.Email" class="form-control"/><span asp-validation-for="Input.Email" class="text-danger"></span></div><div><label asp-for="Input.Password" class="form-label">Password</label><input asp-for="Input.Password" class="form-control"/><small class="text-secondary">At least 8 characters, with uppercase, number, and symbol.</small><span asp-validation-for="Input.Password" class="text-danger"></span></div><div><label asp-for="Input.ConfirmPassword" class="form-label">Confirm password</label><input asp-for="Input.ConfirmPassword" class="form-control"/><span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span></div><div asp-validation-summary="ModelOnly" class="text-danger"></div><button class="btn btn-primary">Create account</button><p class="small">Already have an account? <a asp-page="Login">Login</a></p></form></div><partial name="_ValidationScriptsPartial"/>
